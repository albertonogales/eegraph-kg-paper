eego:PSI
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Phase slope index"@en ;
    skos:notation "psi"^^xsd:string ;
    eego:scope eego:Pairwise ;
    eego:symmetry eego:Directed ;
    eego:bandResolved true ;
    eego:threshold "0.0"^^xsd:decimal .

# ── Electrode position individuals (10/20, 10/10, 10/5 systems) ──────────────
# Source: Jurcak V, Tsuzuki D, Dan I (2007) 10/20, 10/10, and 10/5 systems
#   revisited. Clin Neurophysiol 118(11):2154-2170.
#   https://doi.org/10.1016/j.clinph.2007.04.223
# 2-D coordinates: azimuthal equidistant projection centred at Cz,
#   derived from MNE-Python standard_1005 montage (3-D positions),
#   scaled so T7/T8 are at x=±0.80.

