@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix eego:    <http://eegraph.org/ontology#> .
@prefix schema:  <https://schema.org/> .

# ── Ontology declaration ──────────────────────────────────────────────────────

<http://eegraph.org/ontology>
    a owl:Ontology ;
    rdfs:label "EEGraph EEG Ontology (eego)"^^xsd:string ;
    dcterms:description "Application ontology for the EEGraph Knowledge Graph. Defines classes and named individuals for EEG connectivity modelling, including electrode positions for the international 10/20 and 10/10 systems. Electrode position terms are introduced here because no currently published OWL ontology provides stable, dereferenceable URIs for individual scalp electrode positions."^^xsd:string ;
    dcterms:creator "Alberto Nogales"^^xsd:string ;
    owl:versionInfo "1.0.0"^^xsd:string .

# ── Classes ───────────────────────────────────────────────────────────────────

eego:VirtualSensor
    a owl:Class ;
    rdfs:subClassOf sosa:Sensor ;
    rdfs:label "Virtual sensor"^^xsd:string ;
    rdfs:comment "A sensor whose signal is derived computationally from one or more physical sensors rather than measured directly by a hardware transducer. Subclass of sosa:Sensor because it acts as the observation platform for derived measurements."^^xsd:string .

eego:Electrode
    a owl:Class ;
    rdfs:subClassOf sosa:Sensor ;
    rdfs:label "EEG electrode"^^xsd:string ;
    rdfs:comment "A physical scalp electrode used for electroencephalographic recording."^^xsd:string .

eego:BipolarChannel
    a owl:Class ;
    rdfs:subClassOf eego:VirtualSensor ;
    rdfs:label "Bipolar EEG channel"^^xsd:string ;
    rdfs:comment "A virtual (derived) EEG channel whose signal is the algebraic difference of the potentials at two physical electrodes (positivePole minus negativePole). Modelled as a sosa:Sensor (via eego:VirtualSensor) because it acts as the observation platform for differential measurements, even though it has no physical counterpart — the derivation is performed by the amplifier or in software."^^xsd:string .

eego:ConnectivityEdge
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "EEG connectivity edge"^^xsd:string ;
    rdfs:comment "A weighted edge representing the functional connectivity between two EEG channels within a time window. May be directed (DTF) or undirected depending on the measure."^^xsd:string .

eego:ConnectivityMeasure
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "EEG connectivity measure"^^xsd:string ;
    rdfs:comment "A named method for quantifying functional connectivity between EEG channels."^^xsd:string .

eego:ConnectivityComputation
    a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Connectivity computation"^^xsd:string ;
    rdfs:comment "One execution of a connectivity algorithm on one EEG recording. Carries the threshold, threshold rule, and connectivity measure used to produce the edges or node measurements in that run."^^xsd:string .

eego:NodeMeasurement
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "EEG node measurement"^^xsd:string ;
    rdfs:comment "A per-channel measurement value for a single-channel connectivity measure (e.g. power spectrum, spectral entropy) within a time window."^^xsd:string .

eego:TimeWindow
    a owl:Class ;
    rdfs:subClassOf time:Interval ;
    rdfs:label "EEG time window"^^xsd:string ;
    rdfs:comment "A fixed-duration segment of an EEG recording over which connectivity is computed."^^xsd:string .

eego:AnnotatedEvent
    a owl:Class ;
    rdfs:subClassOf time:Interval ;
    rdfs:label "Annotated event"^^xsd:string ;
    rdfs:comment "A time-bounded event annotated in an EEG recording. Covers any temporally anchored marker — clinical findings, experimental stimuli, behavioural responses, or quality flags. Dataset-independent: the event type is expressed via eego:hasEventType."^^xsd:string .

eego:EventType
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Event type"^^xsd:string ;
    rdfs:comment "A controlled vocabulary term classifying an AnnotatedEvent."^^xsd:string .

# ── Cardinality restrictions ─────────────────────────────────────────────────
# These subClassOf restrictions express the intended cardinality of each
# property per domain class.  They complement the owl:FunctionalProperty
# declarations (which enforce max-1 globally) with min-cardinality axioms and
# per-class max-1 constraints for properties whose domain is a union.

# BipolarChannel
eego:BipolarChannel
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:positivePole ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:Electrode ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:negativePole ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:Electrode ] .

# Electrode
eego:Electrode
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:hasStandardPosition ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:Electrode ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:scalp2DX ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:decimal ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:scalp2DY ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:decimal ] .

# ConnectivityEdge
eego:ConnectivityEdge
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:sourceElectrode ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass sosa:Sensor ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:targetElectrode ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass sosa:Sensor ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:inWindow ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:TimeWindow ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:derivedFrom ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass sosa:ObservationCollection ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:weight ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:decimal ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:connectivityMeasure ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:ConnectivityMeasure ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:thresholdRule ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:ThresholdRule ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:frequencyBand ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:FrequencyBand ] .

# ConnectivityMeasure
eego:ConnectivityMeasure
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:scope ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:MeasureScope ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:symmetry ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:MeasureSymmetry ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:bandResolved ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:boolean ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:minValue ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:decimal ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:maxValue ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:decimal ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:threshold ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:decimal ] .

# ConnectivityComputation
eego:ConnectivityComputation
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:connectivityMeasure ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:ConnectivityMeasure ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:threshold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:decimal ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:thresholdRule ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:ThresholdRule ] .

# NodeMeasurement
eego:NodeMeasurement
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:measure ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:ConnectivityMeasure ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:ofSensor ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass sosa:Sensor ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:value ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:decimal ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:frequencyBand ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:FrequencyBand ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:thresholdRule ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:ThresholdRule ] .

# TimeWindow
eego:TimeWindow
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:frequencyBand ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:FrequencyBand ] .

# AnnotatedEvent
eego:AnnotatedEvent
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:hasEventType ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass eego:EventType ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:inRecording ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass sosa:ObservationCollection ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:eventOnset ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:float ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:eventOffset ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:float ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eego:eventLabel ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:string ] .

# ── Object properties ─────────────────────────────────────────────────────────

eego:positivePole
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label  "positive pole"^^xsd:string ;
    rdfs:domain eego:BipolarChannel ;
    rdfs:range  eego:Electrode ;
    rdfs:comment "The positive electrode pole of a bipolar channel. Exact cardinality 1."^^xsd:string .

eego:negativePole
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label  "negative pole"^^xsd:string ;
    rdfs:domain eego:BipolarChannel ;
    rdfs:range  eego:Electrode ;
    rdfs:comment "The negative electrode pole of a bipolar channel. Exact cardinality 1."^^xsd:string .

eego:sourceElectrode
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label  "source electrode"^^xsd:string ;
    rdfs:domain eego:ConnectivityEdge ;
    rdfs:range  sosa:Sensor ;
    rdfs:comment "The first endpoint of a connectivity edge. Range is sosa:Sensor to accommodate both monopolar and bipolar montages."^^xsd:string .

eego:targetElectrode
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label  "target electrode"^^xsd:string ;
    rdfs:domain eego:ConnectivityEdge ;
    rdfs:range  sosa:Sensor ;
    rdfs:comment "The second endpoint of a connectivity edge. Range is sosa:Sensor to accommodate both monopolar and bipolar montages."^^xsd:string .

eego:inWindow
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label  "in window"^^xsd:string ;
    rdfs:domain eego:ConnectivityEdge ;
    rdfs:range  eego:TimeWindow ;
    rdfs:comment "Links a connectivity edge to the time window in which it was computed. Exact cardinality 1."^^xsd:string .

eego:directedConnection
    a owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:label  "directed connection"^^xsd:string ;
    rdfs:domain sosa:Sensor ;
    rdfs:range  sosa:Sensor ;
    rdfs:comment "Directed functional connectivity relationship from a source sensor to a target sensor. Used for directed measures such as DTF."^^xsd:string .

eego:measure
    a owl:ObjectProperty ;
    rdfs:label  "measure"^^xsd:string ;
    rdfs:domain eego:NodeMeasurement ;
    rdfs:range  eego:ConnectivityMeasure ;
    rdfs:comment "Links a node measurement to the connectivity measure used to compute it."^^xsd:string .

eego:ofSensor
    a owl:ObjectProperty ;
    rdfs:label  "of sensor"^^xsd:string ;
    rdfs:domain eego:NodeMeasurement ;
    rdfs:range  sosa:Sensor ;
    rdfs:comment "Links a node measurement to the sensor (electrode or bipolar channel) it was computed for."^^xsd:string .

eego:derivedFrom
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:label  "derived from"^^xsd:string ;
    rdfs:domain eego:ConnectivityEdge ;
    rdfs:range  sosa:ObservationCollection ;
    rdfs:comment "Links a connectivity edge to the source EEG recording it was derived from."^^xsd:string .

eego:hasStandardPosition
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label  "has standard position"^^xsd:string ;
    rdfs:domain eego:Electrode ;
    rdfs:range  eego:Electrode ;
    rdfs:comment "Links a KG electrode instance to the corresponding ontology-defined standard electrode position individual (e.g. from the 10/20, 10/10 or 10/5 system)."^^xsd:string .

# ── Datatype properties ───────────────────────────────────────────────────────

eego:weight
    a owl:DatatypeProperty ;
    rdfs:label  "connectivity weight"^^xsd:string ;
    rdfs:domain eego:ConnectivityEdge ;
    rdfs:range  xsd:decimal ;
    rdfs:comment "Numeric connectivity weight. Value bounds depend on the measure; see eego:minValue and eego:maxValue on the ConnectivityMeasure individual. Exact cardinality 1 per ConnectivityEdge."^^xsd:string .

eego:value
    a owl:DatatypeProperty ;
    rdfs:label  "measurement value"^^xsd:string ;
    rdfs:domain eego:NodeMeasurement ;
    rdfs:range  xsd:decimal ;
    rdfs:comment "Numeric value of a per-channel measurement."^^xsd:string .


eego:connectivityMeasure
    a owl:ObjectProperty ;
    rdfs:label  "connectivity measure"^^xsd:string ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( eego:ConnectivityEdge eego:ConnectivityComputation ) ] ;
    rdfs:range  eego:ConnectivityMeasure ;
    rdfs:comment "Links a connectivity edge or ConnectivityComputation to the ConnectivityMeasure individual describing the method used."^^xsd:string .

eego:threshold
    a owl:DatatypeProperty ;
    rdfs:label  "threshold"^^xsd:string ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( eego:ConnectivityComputation eego:ConnectivityMeasure ) ] ;
    rdfs:range  xsd:decimal ;
    rdfs:comment "On eego:ConnectivityComputation: the effective edge inclusion threshold applied in that run (exact cardinality 1). On eego:ConnectivityMeasure: the reference threshold for that measure, used when no explicit threshold is supplied by the user."^^xsd:string .


eego:scope
    a owl:ObjectProperty ;
    rdfs:label  "measure scope"^^xsd:string ;
    rdfs:domain eego:ConnectivityMeasure ;
    rdfs:range  eego:MeasureScope ;
    rdfs:comment "Links a connectivity measure to its scope: Pairwise or SingleChannel."^^xsd:string .

eego:symmetry
    a owl:ObjectProperty ;
    rdfs:label  "measure symmetry"^^xsd:string ;
    rdfs:domain eego:ConnectivityMeasure ;
    rdfs:range  eego:MeasureSymmetry ;
    rdfs:comment "Links a connectivity measure to its symmetry class: Symmetric, Asymmetric, Antisymmetric, or Directed."^^xsd:string .

eego:bandResolved
    a owl:DatatypeProperty ;
    rdfs:label  "band resolved"^^xsd:string ;
    rdfs:domain eego:ConnectivityMeasure ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "True if the measure is computed per frequency band."^^xsd:string .

eego:minValue
    a owl:DatatypeProperty ;
    rdfs:label  "minimum value"^^xsd:string ;
    rdfs:domain eego:ConnectivityMeasure ;
    rdfs:range  xsd:decimal ;
    rdfs:comment "Theoretical minimum of the connectivity measure's output range."^^xsd:string .

eego:maxValue
    a owl:DatatypeProperty ;
    rdfs:label  "maximum value"^^xsd:string ;
    rdfs:domain eego:ConnectivityMeasure ;
    rdfs:range  xsd:decimal ;
    rdfs:comment "Theoretical maximum of the connectivity measure's output range. Absent for unbounded measures."^^xsd:string .

eego:frequencyBand
    a owl:ObjectProperty ;
    rdfs:label  "frequency band"^^xsd:string ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( eego:ConnectivityEdge eego:NodeMeasurement eego:TimeWindow ) ] ;
    rdfs:range  eego:FrequencyBand ;
    rdfs:comment "Links a connectivity edge, node measurement, or time window to the EEG frequency band in which it was computed. Absent for broadband analyses."^^xsd:string .

# schema:sampleRate reused (not redefined) — declared here for documentation only.
# Usage: sosa:ObservationCollection → schema:sampleRate xsd:decimal (Hz).
# The property IRI is https://schema.org/sampleRate; eego does not coin a duplicate.
schema:sampleRate
    rdfs:label    "sample rate"^^xsd:string ;
    rdfs:comment  "Sampling frequency of the EEG recording in Hz. Applied to sosa:ObservationCollection instances."^^xsd:string ;
    rdfs:domain   sosa:ObservationCollection ;
    rdfs:range    xsd:decimal .

eego:recordingCondition
    a owl:ObjectProperty ;
    rdfs:label  "recording condition"^^xsd:string ;
    rdfs:domain sosa:ObservationCollection ;
    rdfs:range  eego:RecordingCondition ;
    rdfs:comment "Links an EEG recording to the experimental or clinical condition under which it was acquired."^^xsd:string .

eego:thresholdRule
    a owl:ObjectProperty ;
    rdfs:label  "threshold rule"^^xsd:string ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( eego:ConnectivityComputation eego:ConnectivityEdge eego:NodeMeasurement ) ] ;
    rdfs:range  eego:ThresholdRule ;
    rdfs:comment "Links a connectivity computation, connectivity edge, or node measurement to the SKOS concept describing how the inclusion threshold was applied."^^xsd:string .

eego:hasEventType
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label  "has event type"^^xsd:string ;
    rdfs:domain eego:AnnotatedEvent ;
    rdfs:range  eego:EventType ;
    rdfs:comment "Links an annotated event to the controlled-vocabulary term classifying it."^^xsd:string .


eego:inRecording
    a owl:ObjectProperty ;
    rdfs:label  "in recording"^^xsd:string ;
    rdfs:domain eego:AnnotatedEvent ;
    rdfs:range  sosa:ObservationCollection ;
    rdfs:comment "Links an annotated event to the EEG recording in which it was annotated."^^xsd:string .

eego:eventOnset
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label  "event onset"^^xsd:string ;
    rdfs:domain eego:AnnotatedEvent ;
    rdfs:range  xsd:float ;
    rdfs:comment "Start time of the annotated event in seconds from the beginning of the recording."^^xsd:string .

eego:eventOffset
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label  "event offset"^^xsd:string ;
    rdfs:domain eego:AnnotatedEvent ;
    rdfs:range  xsd:float ;
    rdfs:comment "End time of the annotated event in seconds from the beginning of the recording."^^xsd:string .

eego:eventLabel
    a owl:DatatypeProperty ;
    rdfs:label  "event label"^^xsd:string ;
    rdfs:domain eego:AnnotatedEvent ;
    rdfs:range  xsd:string ;
    rdfs:comment "Free-text label for the annotated event, e.g. 'Seizure 1' or 'Stimulus A'."^^xsd:string .

eego:scalp2DX
    a owl:DatatypeProperty ;
    rdfs:label  "scalp 2-D x coordinate"^^xsd:string ;
    rdfs:domain eego:Electrode ;
    rdfs:range  xsd:decimal ;
    rdfs:comment "Normalised 2-D scalp x coordinate in [-1, 1]. Defined only for standard 10/20 and 10/10 positions."^^xsd:string .

eego:scalp2DY
    a owl:DatatypeProperty ;
    rdfs:label  "scalp 2-D y coordinate"^^xsd:string ;
    rdfs:domain eego:Electrode ;
    rdfs:range  xsd:decimal ;
    rdfs:comment "Normalised 2-D scalp y coordinate in [-1, 1]. Defined only for standard 10/20 and 10/10 positions."^^xsd:string .

# ── MeasureScope SKOS scheme ─────────────────────────────────────────────────

eego:MeasureScopeScheme
    a skos:ConceptScheme ;
    rdfs:label "EEG measure scope scheme"^^xsd:string ;
    skos:prefLabel "Measure Scope"@en .

eego:MeasureScope
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Measure scope"^^xsd:string .

eego:Pairwise
    a owl:NamedIndividual, eego:MeasureScope ;
    skos:inScheme eego:MeasureScopeScheme ;
    skos:prefLabel "Pairwise"@en ;
    skos:notation "Pairwise"^^xsd:string ;
    skos:definition "The measure operates on a pair of channels and produces one value per pair."@en .

eego:SingleChannel
    a owl:NamedIndividual, eego:MeasureScope ;
    skos:inScheme eego:MeasureScopeScheme ;
    skos:prefLabel "Single channel"@en ;
    skos:notation "SingleChannel"^^xsd:string ;
    skos:definition "The measure operates on a single channel and produces one value per channel."@en .

# ── MeasureSymmetry SKOS scheme ───────────────────────────────────────────────

eego:MeasureSymmetryScheme
    a skos:ConceptScheme ;
    rdfs:label "EEG measure symmetry scheme"^^xsd:string ;
    skos:prefLabel "Measure Symmetry"@en .

eego:MeasureSymmetry
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Measure symmetry"^^xsd:string .

eego:Symmetric
    a owl:NamedIndividual, eego:MeasureSymmetry ;
    skos:inScheme eego:MeasureSymmetryScheme ;
    skos:prefLabel "Symmetric"@en ;
    skos:notation "Symmetric"^^xsd:string ;
    skos:definition "M(A,B) = M(B,A); the connectivity relationship is undirected."@en .

eego:Asymmetric
    a owl:NamedIndividual, eego:MeasureSymmetry ;
    skos:inScheme eego:MeasureSymmetryScheme ;
    skos:prefLabel "Asymmetric"@en ;
    skos:notation "Asymmetric"^^xsd:string ;
    skos:definition "M(A,B) ≠ M(B,A) in general; direction affects the value but is not a causal claim."@en .

eego:Antisymmetric
    a owl:NamedIndividual, eego:MeasureSymmetry ;
    skos:inScheme eego:MeasureSymmetryScheme ;
    skos:prefLabel "Antisymmetric"@en ;
    skos:notation "Antisymmetric"^^xsd:string ;
    skos:definition "M(A,B) = −M(B,A); the value changes sign when source and target are swapped."@en .

eego:Directed
    a owl:NamedIndividual, eego:MeasureSymmetry ;
    skos:inScheme eego:MeasureSymmetryScheme ;
    skos:prefLabel "Directed"@en ;
    skos:notation "Directed"^^xsd:string ;
    skos:definition "The measure encodes a causal or flow direction from source to target."@en .

# ── ThresholdRule SKOS scheme ─────────────────────────────────────────────────

eego:ThresholdRuleScheme
    a skos:ConceptScheme ;
    rdfs:label "EEG threshold rule scheme"^^xsd:string ;
    skos:prefLabel "Threshold Rule"@en .

eego:ThresholdRule
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Threshold rule"^^xsd:string .

eego:ValueAbove
    a owl:NamedIndividual, eego:ThresholdRule ;
    skos:inScheme eego:ThresholdRuleScheme ;
    skos:prefLabel "Value above"@en ;
    skos:notation "ValueAbove"^^xsd:string ;
    skos:definition "Edge kept if value > threshold; signed comparison."@en .

eego:MagnitudeAboveUndirected
    a owl:NamedIndividual, eego:ThresholdRule ;
    skos:inScheme eego:ThresholdRuleScheme ;
    skos:prefLabel "Magnitude above (undirected)"@en ;
    skos:notation "MagnitudeAboveUndirected"^^xsd:string ;
    skos:definition "Edge kept if |value| > threshold; stored undirected, direction discarded."@en .

eego:TopFraction
    a owl:NamedIndividual, eego:ThresholdRule ;
    skos:inScheme eego:ThresholdRuleScheme ;
    skos:prefLabel "Top fraction"@en ;
    skos:notation "TopFraction"^^xsd:string ;
    skos:definition "Channels in the top fraction of values are selected."@en .

# ── Frequency band SKOS scheme ───────────────────────────────────────────────

eego:FrequencyBand
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Frequency band"^^xsd:string ;
    rdfs:comment "An EEG frequency band defined by its canonical Hz range."^^xsd:string .

eego:FrequencyBandScheme
    a skos:ConceptScheme ;
    rdfs:label "EEG frequency band scheme"^^xsd:string ;
    skos:prefLabel "EEG Frequency Bands"@en .

eego:Delta
    a owl:NamedIndividual, eego:FrequencyBand ;
    skos:inScheme eego:FrequencyBandScheme ;
    skos:prefLabel "Delta"@en ;
    skos:notation "delta"^^xsd:string ;
    skos:definition "0.5–4 Hz. Dominant in deep sleep; elevated in disorders of consciousness."@en .

eego:Theta
    a owl:NamedIndividual, eego:FrequencyBand ;
    skos:inScheme eego:FrequencyBandScheme ;
    skos:prefLabel "Theta"@en ;
    skos:notation "theta"^^xsd:string ;
    skos:definition "4–8 Hz. Associated with drowsiness, memory encoding, and hippocampal activity."@en .

eego:Alpha
    a owl:NamedIndividual, eego:FrequencyBand ;
    skos:inScheme eego:FrequencyBandScheme ;
    skos:prefLabel "Alpha"@en ;
    skos:notation "alpha"^^xsd:string ;
    skos:definition "8–13 Hz. Prominent during relaxed wakefulness with eyes closed."@en .

eego:Beta
    a owl:NamedIndividual, eego:FrequencyBand ;
    skos:inScheme eego:FrequencyBandScheme ;
    skos:prefLabel "Beta"@en ;
    skos:notation "beta"^^xsd:string ;
    skos:definition "13–30 Hz. Associated with active thinking, motor planning, and alertness."@en .

eego:Gamma
    a owl:NamedIndividual, eego:FrequencyBand ;
    skos:inScheme eego:FrequencyBandScheme ;
    skos:prefLabel "Gamma"@en ;
    skos:notation "gamma"^^xsd:string ;
    skos:definition "30–100 Hz. Linked to higher cognitive processing and cross-regional binding."@en .

# ── Recording condition SKOS scheme ──────────────────────────────────────────

eego:RecordingCondition
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Recording condition"^^xsd:string ;
    rdfs:comment "The experimental or clinical state of the subject during EEG acquisition."^^xsd:string .

eego:RecordingConditionScheme
    a skos:ConceptScheme ;
    rdfs:label "EEG recording condition scheme"^^xsd:string ;
    skos:prefLabel "EEG Recording Conditions"@en .

eego:RestingState
    a owl:NamedIndividual, eego:RecordingCondition ;
    skos:inScheme eego:RecordingConditionScheme ;
    skos:prefLabel "Resting state"@en ;
    skos:notation "resting_state"^^xsd:string ;
    skos:definition "Subject is at rest with no explicit task; eyes open or closed."@en .

eego:TaskRelated
    a owl:NamedIndividual, eego:RecordingCondition ;
    skos:inScheme eego:RecordingConditionScheme ;
    skos:prefLabel "Task-related"@en ;
    skos:notation "task_related"^^xsd:string ;
    skos:definition "Subject is performing a defined cognitive, motor, or sensory task."@en .

eego:PathologicalActivity
    a owl:NamedIndividual, eego:RecordingCondition ;
    skos:inScheme eego:RecordingConditionScheme ;
    skos:prefLabel "Pathological activity"@en ;
    skos:notation "pathological_activity"^^xsd:string ;
    skos:definition "Recording shows abnormal brain activity indicative of a neurological condition (e.g. seizure, epileptiform discharge, tumour-related activity). Condition type is expressed via eego:AnnotatedEvent."@en .

eego:AlteredConsciousness
    a owl:NamedIndividual, eego:RecordingCondition ;
    skos:inScheme eego:RecordingConditionScheme ;
    skos:prefLabel "Altered consciousness"@en ;
    skos:notation "altered_consciousness"^^xsd:string ;
    skos:definition "Subject is in a state of reduced or modified wakefulness, including sleep, pharmacological sedation, anaesthesia, or a disorder of consciousness. Specific state expressed via eego:AnnotatedEvent."@en .

# ── Event type SKOS scheme ────────────────────────────────────────────────────

# No built-in EventType individuals are defined here.
# The EventType class and hasEventType property provide the structural hook;
# domain-specific vocabularies (e.g. SNOMED CT, HED, a custom SKOS scheme)
# supply the actual terms. Pass either a full URI or a plain string label
# via the pipeline's annotations parameter.

# ── Connectivity measure individuals ─────────────────────────────────────────

eego:PearsonCorrelation
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Pearson correlation"@en ;
    skos:notation "pearson_correlation"^^xsd:string ;
    skos:closeMatch <http://purl.obolibrary.org/obo/STATO_0000280> ;
    eego:scope eego:Pairwise ;
    eego:symmetry eego:Symmetric ;
    eego:bandResolved false ;
    eego:minValue "-1.0"^^xsd:decimal ;
    eego:maxValue "1.0"^^xsd:decimal ;
    eego:threshold "0.7"^^xsd:decimal .

eego:CrossCorrelation
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Cross-correlation"@en ;
    skos:notation "cross_correlation"^^xsd:string ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/STATO_0000280> ;
    eego:scope eego:Pairwise ;
    eego:symmetry eego:Asymmetric ;
    eego:bandResolved false ;
    eego:minValue "-1.0"^^xsd:decimal ;
    eego:maxValue "1.0"^^xsd:decimal ;
    eego:threshold "0.5"^^xsd:decimal .

eego:CrossCorrelationAsymmetry
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Cross-correlation asymmetry"@en ;
    skos:notation "corr_cross_correlation"^^xsd:string ;
    skos:note "Computes R_xy(τ) − R_xy(−τ) on the normalised cross-correlation, averaged over short positive lags (0–10 % of window). Antisymmetric by construction: CCA(A→B) = −CCA(B→A). See: Wendling et al. (2009) and related directed cross-correlation literature."@en ;
    eego:scope eego:Pairwise ;
    eego:symmetry eego:Antisymmetric ;
    eego:bandResolved false ;
    eego:minValue "-2.0"^^xsd:decimal ;
    eego:maxValue "2.0"^^xsd:decimal ;
    eego:threshold "0.1"^^xsd:decimal .

eego:SquaredCoherence
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Squared coherence"@en ;
    skos:notation "squared_coherence"^^xsd:string ;
    eego:scope eego:Pairwise ;
    eego:symmetry eego:Symmetric ;
    eego:bandResolved true ;
    eego:minValue "0.0"^^xsd:decimal ;
    eego:maxValue "1.0"^^xsd:decimal ;
    eego:threshold "0.65"^^xsd:decimal .

eego:ImaginaryCoherence
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Imaginary coherence"@en ;
    skos:notation "imag_coherence"^^xsd:string ;
    eego:scope eego:Pairwise ;
    eego:symmetry eego:Antisymmetric ;
    eego:bandResolved true ;
    eego:minValue "-1.0"^^xsd:decimal ;
    eego:maxValue "1.0"^^xsd:decimal ;
    eego:threshold "0.4"^^xsd:decimal .

eego:WPLI
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Weighted phase lag index"@en ;
    skos:notation "wpli"^^xsd:string ;
    eego:scope eego:Pairwise ;
    eego:symmetry eego:Symmetric ;
    eego:bandResolved true ;
    eego:minValue "0.0"^^xsd:decimal ;
    eego:maxValue "1.0"^^xsd:decimal ;
    eego:threshold "0.45"^^xsd:decimal .

eego:PLV
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Phase locking value"@en ;
    skos:notation "plv"^^xsd:string ;
    eego:scope eego:Pairwise ;
    eego:symmetry eego:Symmetric ;
    eego:bandResolved true ;
    eego:minValue "0.0"^^xsd:decimal ;
    eego:maxValue "1.0"^^xsd:decimal ;
    eego:threshold "0.8"^^xsd:decimal .
    # TODO: skos:closeMatch to STATO/OBI term

eego:PLI
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Phase lag index"@en ;
    skos:notation "pli"^^xsd:string ;
    eego:scope eego:Pairwise ;
    eego:symmetry eego:Symmetric ;
    eego:bandResolved false ;
    eego:minValue "0.0"^^xsd:decimal ;
    eego:maxValue "1.0"^^xsd:decimal ;
    eego:threshold "0.1"^^xsd:decimal .
    # TODO: skos:closeMatch to STATO/OBI term


eego:DTF
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Directed transfer function"@en ;
    skos:notation "dtf"^^xsd:string ;
    eego:scope eego:Pairwise ;
    eego:symmetry eego:Directed ;
    eego:bandResolved true ;
    eego:minValue "0.0"^^xsd:decimal ;
    eego:maxValue "1.0"^^xsd:decimal ;
    eego:threshold "0.3"^^xsd:decimal .
    # TODO: skos:closeMatch to STATO/OBI term

eego:GrangerCausality
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Granger causality"@en ;
    skos:notation "granger_causality"^^xsd:string ;
    eego:scope eego:Pairwise ;
    eego:symmetry eego:Directed ;
    eego:bandResolved false ;
    eego:minValue "0.0"^^xsd:decimal ;
    eego:maxValue "1.0"^^xsd:decimal ;
    eego:threshold "0.1"^^xsd:decimal .

eego:PowerSpectrum
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Power spectrum"@en ;
    skos:notation "power_spectrum"^^xsd:string ;
    eego:scope eego:SingleChannel ;
    eego:bandResolved true ;
    eego:minValue "0.0"^^xsd:decimal ;
    eego:threshold "0.25"^^xsd:decimal .
    # TODO: skos:closeMatch to STATO/OBI term

eego:SpectralEntropy
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Spectral entropy"@en ;
    skos:notation "spectral_entropy"^^xsd:string ;
    eego:scope eego:SingleChannel ;
    eego:bandResolved true ;
    eego:minValue "0.0"^^xsd:decimal ;
    eego:maxValue "1.0"^^xsd:decimal ;
    eego:threshold "0.25"^^xsd:decimal .
    # TODO: skos:closeMatch to STATO/OBI term

eego:ShannonEntropy
    a owl:NamedIndividual, eego:ConnectivityMeasure ;
    skos:prefLabel "Shannon entropy"@en ;
    skos:notation "shannon_entropy"^^xsd:string ;
    eego:scope eego:SingleChannel ;
    eego:bandResolved false ;
    eego:minValue "0.0"^^xsd:decimal ;
    eego:threshold "0.25"^^xsd:decimal .
    # TODO: skos:closeMatch to STATO/OBI term

